{
  "name": "loa-rogue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.16.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx apps/server/src/index.ts",
    "dev:web": "npm run dev -w @loa/web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test apps/server/test/*.test.ts packages/shared/src/*.test.ts",
    "build": "npm run typecheck && npm run build -w @loa/web && npm run build -w @loa/server",
    "start": "node --env-file-if-exists=.env apps/server/dist/index.js",
    "db:init": "node --env-file-if-exists=.env --import tsx apps/server/src/db-init.ts",
    "db:backup": "node --env-file-if-exists=.env --import tsx apps/server/src/backup.ts",
    "env:init": "node scripts/init-env.mjs",
    "test:e2e": "npm run build && playwright test",
    "serve:public": "node --env-file-if-exists=.env scripts/serve-public.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
